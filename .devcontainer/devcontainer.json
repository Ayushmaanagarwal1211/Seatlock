// GitHub Codespaces setup: Node.js + Docker, nothing to install on your own machine.
// Pinned to Debian bookworm: the docker-in-docker feature does not install on trixie.
{
  "name": "seatlock",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "npm install && cp -n .env.example .env",
  "forwardPorts": [4000],
  "portsAttributes": { "4000": { "label": "Seatlock API" } }
}
