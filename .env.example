# Copy to .env (cp .env.example .env). Values match docker-compose.yml.
PORT=4000
DATABASE_URL=postgres://seatlock:seatlock@localhost:5433/seatlock
REDIS_URL=redis://localhost:6380

# pessimistic | optimistic | redis (see docs/design.md)
HOLD_STRATEGY=pessimistic

# Payment gateway (npm run dev starts the mock one on port 4100)
GATEWAY_URL=http://localhost:4100
GATEWAY_API_KEY=sk_test_seatlock
GATEWAY_WEBHOOK_SECRET=whsec_test_seatlock

# Relay (my email delivery service) sends the confirmation emails. Leave unset to only log them.
# RELAY_URL=http://localhost:3000

# Flash sales: postgres (hot-row baseline) | redis-kafka
FLASH_STRATEGY=redis-kafka
KAFKA_BROKERS=localhost:9092

# Integration tests
TEST_DATABASE_URL=postgres://seatlock:seatlock@localhost:5433/seatlock_test
TEST_REDIS_URL=redis://localhost:6380/1
TEST_KAFKA_BROKERS=localhost:9092
